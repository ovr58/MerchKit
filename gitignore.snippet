# === Строки для .gitignore нового проекта (добавить к своим) ===
# Скопируй нужное в корневой .gitignore проекта. Этот файл — не второй список, а тот же
# .gitignore шаблона, размеченный по носителям: строка нужна, только пока в проекте есть
# инструмент, который её порождает. Убрал инструмент (таблица модулей `docs/METHODOLOGY.md`) — убери и строку.

# --- Всегда ---
# Локальные override прав Claude Code — машинно-зависимы, НЕ коммитить.
.claude/settings.local.json

# Личный локальный оверлей правил для Harvi Code — машинно-зависим, НЕ коммитить.
AGENTS.local.md

# Опциональная переносимая память проекта (docs/MEMORY_GUIDE.md) — локальная, НЕ коммитить.
.ai-memory/

# Крупные машинные артефакты планирования (вне git).
planning/archive/artifacts/

# Логи прогонов (если ведёшь tail/JSON-логи для мониторинга).
logs/
*.log

# Секреты — НИКОГДА в git.
.env
.envrc
secrets.*
credentials.json
*.key

# --- Пока есть озвучивание (Stop-хук + Piper, docs/SPEECH_SETUP.md) ---
# Переключатель озвучивания ответов (/speech on|off) — машинное состояние, НЕ коммитить.
.claude/tts-enabled
# Бинарник и голосовые модели Piper — десятки МБ, скачиваются по требованию.
tools/piper/bin/
tools/piper/voices/

# --- Пока есть модуль «Супервизор» (команда /supervisor-prompt; строка в docs/METHODOLOGY.md) ---
# Отчёты исполнителей, открытых владельцем в отдельных окнах (.claude/agents/plan-executor.md).
.tmp-review/

# NB: per-project долгая память живёт в ~/.claude/projects/<hash>/memory/,
#     то есть ВНЕ репозитория — отдельно игнорировать не нужно.
