# Пример переменных окружения. Реальные значения — в .env (в git не попадает).
#
# ГРАНИЦА, КОТОРУЮ НЕЛЬЗЯ ПЕРЕСЕКАТЬ: всё с префиксом VITE_ попадает в бандл фронтенда
# и открыто любому посетителю сайта. Ключ AI-провайдера, ключ шлюза и service-role
# сюда не кладут никогда — их место в секретах Supabase Edge Functions
# (`supabase secrets set ...`), см. docs/SPEC.md §5, §6.

# --- Клиент (публично по устройству Supabase; данные защищает RLS, а не эти ключи) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-ключ проекта Supabase>

# --- Сервер: только для локальных прогонов Edge Functions ---
# На prod те же значения задаются секретами Supabase, а не файлом.
SUPABASE_SERVICE_ROLE_KEY=<service-role ключ; полный доступ в обход RLS>

# Доступ к AI-провайдеру на время приёмки — через шлюз AITunnel (решение 2026-08-27,
# docs/SPEC.md §2). Профиль провайдера задаётся конфигурацией, а не зашит в код:
# смена шлюза или переход на прямой доступ к вендору — правка этих переменных.
AI_GATEWAY_BASE_URL=<базовый URL API шлюза>
AI_GATEWAY_API_KEY=<ключ шлюза>
AI_IMAGE_MODEL=gemini-2-5-flash-image
AI_TEXT_MODEL=<модель для распознавания и текстов карточки>
