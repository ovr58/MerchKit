{
  "name": "merch-kit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "test": "vitest run",
    "test:db": "supabase test db",
    "test:billing": "node supabase/tests/billing-flow.mjs",
    "test:flow": "node supabase/tests/auth-flow.mjs",
    "test:watch": "vitest",
    "test:generation": "node supabase/tests/generation-flow.mjs",
    "test:ui": "node e2e/us01.mjs",
    "bench": "node bench/run.mjs",
    "cards:roundtrip": "node --experimental-strip-types tools/card-pipeline/roundtrip.mts",
    "cards:parse": "node --env-file=.env --experimental-strip-types tools/card-pipeline/parse.mts",
    "cards:assets": "node --experimental-strip-types tools/card-pipeline/assets.mts",
    "cards:layouts": "node --experimental-strip-types tools/card-pipeline/layouts.mts",
    "cards:layout-tags": "node --env-file=.env --experimental-strip-types tools/card-pipeline/layout-tags.mts",
    "cards:apply-layout-tags": "node --experimental-strip-types tools/card-pipeline/apply-layout-tags.mts",
    "cards:render-assets": "node --experimental-strip-types tools/card-pipeline/render-assets.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@supabase/supabase-js": "^2.58.0",
    "@tanstack/react-query": "^5.102.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.6.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.4.0",
    "jsdom": "^26.0.0",
    "oxlint": "^1.0.0",
    "playwright": "^1.62.1",
    "supabase": "^2.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.1.0"
  }
}
